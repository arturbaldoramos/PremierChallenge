# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=premiere_challenge
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Worker Configuration
MAX_WORKERS_ESTADOS=2
MAX_WORKERS_MUNICIPIOS=4
MAX_WORKERS_MEDICOS=6
MAX_WORKERS_HOSPITAIS=3
MAX_WORKERS_PACIENTES=8
MAX_WORKERS_CID10=2

BATCH_SIZE_ESTADOS=100
BATCH_SIZE_MUNICIPIOS=500
BATCH_SIZE_MEDICOS=10000
BATCH_SIZE_HOSPITAIS=300
BATCH_SIZE_PACIENTES=500
BATCH_SIZE_CID10=800

# Job Configuration
JOB_TIMEOUT_MINUTES=30
JOB_RETENTION_HOURS=24
QUEUE_CHECK_INTERVAL_SECONDS=2

# Development
DEBUG=true
LOG_LEVEL=info